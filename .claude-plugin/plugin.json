{
  "name": "nominal",
  "description": "Nominal skills and MCP server for hardware telemetry, test data, and sensor time-series workflows.",
  "version": "2.0.0",
  "author": {
    "name": "Nominal",
    "url": "https://github.com/nominal-io"
  },
  "homepage": "https://github.com/nominal-io/skills#readme",
  "repository": "https://github.com/nominal-io/skills",
  "license": "Apache-2.0",
  "keywords": [
    "telemetry",
    "hardware-testing",
    "test-data",
    "sensor-data",
    "time-series",
    "nomctl",
    "nominal",
    "mcp"
  ],
  "userConfig": {
    "api_host": {
      "type": "string",
      "title": "Nominal deployment",
      "description": "API host of your Nominal deployment: api.gov.nominal.io (US), api.euw2.nominal.io (EU West), api.euc1.nominal.io (EU Central), api.cac1.nominal.io (Canada).",
      "options": [
        "api.gov.nominal.io",
        "api.euw2.nominal.io",
        "api.euc1.nominal.io",
        "api.cac1.nominal.io"
      ],
      "default": "api.gov.nominal.io"
    }
  },
  "mcpServers": {
    "nominal": {
      "type": "http",
      "url": "https://${user_config.api_host}/mcp",
      "oauth": {
        "clientId": "nominal-mcp",
        "callbackPort": 54545
      }
    }
  }
}
